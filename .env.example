# ============================================================================
# p0bot — Lark long-connection doc Q&A bot — EXAMPLE env
# Copy to `.env` on your server and fill in the real secrets (do NOT commit .env).
# Environment variables override the _CFG defaults in main.py.
# ============================================================================

# ---- Lark app credentials ----
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# International Lark → https://open.larksuite.com ; Feishu (China) → https://open.feishu.cn
LARK_HOST=https://open.larksuite.com

# ---- Receive events via persistent connection (long connection / WebSocket) ----
LARK_EVENT_MODE=ws
ENABLE_HTTP=0

# ---- Turn OFF Grafana monitoring (p0bot is a doc Q&A bot) ----
MONITORING_WATCH_ENABLE=0
GRAFANA_SCREENSHOT_ENABLE=0
GRAFANA_PERSISTENT_BROWSER=0
MONITORING_AI_GATE_ENABLE=0

# ---- p0bot doc Q&A ----
P0_DOC_QA_ENABLE=1
P0_WIKI_URL=https://your-org.larksuite.com/wiki/xxxxxxxxxxxxxxxxxxxxxx
# P0_WIKI_NODE_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
P0_WIKI_INCLUDE_CHILDREN=1
P0_WIKI_MAX_NODES=200
P0_ASK_TRIGGER=/ask
P0_RELOAD_TRIGGER=/reload
P0_QA_ANSWER_DM=1
P0_QA_AT_MENTION_ENABLE=1

# ---- Local Ollama / Qwen ----
P0_QA_OLLAMA_URL=http://localhost:11434
P0_QA_MODEL=qwen3.6:35b-a3b
P0_QA_TIMEOUT_SECONDS=180
P0_QA_NUM_CTX=32768
P0_QA_TEMPERATURE=0.2
P0_DOC_MAX_CHARS=24000
P0_DOC_REFRESH_SECONDS=0

# ---- Local contact directory (name,team,phone) folded into every answer, on top of the wiki ----
# Lets p0bot answer "who do I contact for <team>" / "<person>'s phone" from local data even if the
# wiki doesn't list them. Auto-reloads when the file changes (no /reload). 1=on, 0=off.
P0_CONTACTS_ENABLE=1
# CSV path; empty = contacts.csv next to main.py (ships in the repo, deploys via git pull).
P0_CONTACTS_FILE=
# After answering, if the answer names anyone in the directory, append their phone(s). 1=on.
P0_CONTACTS_APPEND_ENABLE=1

# ---- Message reactions (ACK while thinking, DONE when answered) ----
P0_REACT_ENABLE=1
P0_REACT_ACK_EMOJI=OK
P0_REACT_DONE_EMOJI=DONE
P0_REACT_REMOVE_ACK=1

# ---- Answer formatting: render answers as a clean interactive card ----
P0_ANSWER_CARD=1
P0_CARD_TITLE=📖 p0bot
P0_CARD_TEMPLATE=blue
P0_CARD_MAX_CHARS=8000

# ---- Meeting attendance (Mode C): "/meeting <link-or-number>" attendance report ----
# Needs the app's VC "Meeting Management" report permission (enterprise-admin granted).
P0_MEETING_ENABLE=0
P0_MEETING_TRIGGER=/meeting
P0_MEETING_LOOKBACK_HOURS=6
P0_MEETING_MAX_ROWS=200
P0_MEETING_CARD_TEMPLATE=turquoise
# Admin OAuth (the report needs an admin's user token). Register the redirect_uri in the
# app's Security → Redirect URLs; an admin runs /vcauth once, then /vccode <code>.
P0_VC_REDIRECT_URI=http://localhost:5088/oauth/callback
P0_VC_OAUTH_SCOPES=vc:rooms.room.detailinfo:read offline_access contact:contact.base:readonly contact:user.employee_id:readonly minutes:minutes.transcript:export minutes:minutes.media:export
# REQUIRED for /vcauth //vccode (empty = nobody; * = everyone). Run /vcauth once; the bot replies
# with your open_id. NOTE the stored token is bot-wide, last-writer-wins — with *, whoever ran
# /vcauth last is the identity used by /whotalk and /meeting.
P0_VC_ADMIN_OPEN_IDS=

# ---- Group members: "/members" lists who's in the CHAT GROUP (needs im:chat:readonly + bot in group) ----
P0_MEMBERS_ENABLE=1
P0_MEMBERS_TRIGGER=/members
P0_MEMBERS_CARD_TEMPLATE=blue
P0_MEMBERS_MAX_ROWS=500

# ---- Bot-hosted meeting: /openmeeting (live join/leave + auto-record + recording to host) ----
# Scopes: vc:reserve, vc:meeting:readonly, vc:meeting, vc:record:readonly, contact:contact.base:readonly.
# Subscribe VC events (started/join/leave/ended/recording_ready). Recording must be tenant-enabled.
P0_OPENMEETING_ENABLE=0
P0_OPENMEETING_TRIGGER=/openmeeting
P0_ENDMEETING_TRIGGER=/endmeeting
# /checkmeeting <name> — search bot-hosted meetings for participants whose name matches (e.g.
# "/checkmeeting jun" finds Jun Chen / Jun Hong …) and shows their join/leave times.
P0_CHECKMEETING_TRIGGER=/checkmeeting
P0_MEETING_HOST_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_OPENMEETING_ANNOUNCE_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_OPENMEETING_AUTO_RECORD=1
P0_OPENMEETING_TOPIC=p0bot meeting
P0_OPENMEETING_DURATION_HOURS=4
P0_OPENMEETING_ANNOUNCE_JOINS=1
P0_OPENMEETING_ANNOUNCE_LEAVES=1
P0_OPENMEETING_CARD_TEMPLATE=turquoise
P0_OPENMEETING_ALLOWED_OPEN_IDS=

# ---- /whotalk: who-said-what transcript of a recorded meeting ----
# Lark Minutes supplies speaker names + RAW zh/en text; the LOCAL Qwen fixes ASR errors and adds
# English translations (Lark's own translation is not used). Needs tenant Minutes (妙记) enabled
# and scope minutes:minutes.transcript:export (add + PUBLISH a version). For host-owned minutes the
# stored /vcauth admin token is the fallback — keep the scope in P0_VC_OAUTH_SCOPES and re-/vcauth.
# Usage: /whotalk  |  /whotalk <9-digit meeting no / meeting link>  |  /whotalk <minutes link>
P0_WHOTALK_ENABLE=1
P0_WHOTALK_TRIGGER=/whotalk
# Override the built-in cleanup prompt. Built-in output format per turn (blank line between turns):
#   <Speaker Name>
#   CN : <utterance in Chinese>
#   EN: <utterance in English>
# (original language keeps its wording with errors fixed; the other line is the translation)
P0_WHOTALK_PROMPT=
P0_WHOTALK_CHUNK_CHARS=6000
# Timeout per cleanup pass (regenerating text + translations is slow); a timed-out pass is
# automatically split in half and each half retried once before falling back to raw text.
P0_WHOTALK_QA_TIMEOUT_SECONDS=900
P0_WHOTALK_LOOKBACK_HOURS=72
# Hybrid LOCAL ASR: the bot downloads the recording audio and hears it itself (SenseVoiceSmall via
# sherpa-onnx, ~1GB RAM); names+timestamps still from Minutes SRT. Setup: deploy/setup-whotalk-asr.sh.
# Extra scope: minutes:minutes.media:export (console + publish + re-/vcauth). Auto-falls-back to Lark text.
P0_WHOTALK_ASR_ENABLE=0
# sensevoice (fast, ~1GB) | whisper (faster-whisper medium int8; slower, strong MY/SG code-switching)
P0_WHOTALK_ASR_ENGINE=sensevoice
P0_WHOTALK_ASR_MODEL_DIR=
P0_WHOTALK_ASR_THREADS=4
P0_WHOTALK_ASR_SEG_PAD_MS=150
P0_WHOTALK_ASR_MERGE_GAP_MS=800
P0_WHOTALK_ASR_MAX_TURN_SECONDS=15
P0_WHOTALK_ASR_MAX_MEDIA_MB=1024
P0_WHOTALK_ASR_KEEP_MEDIA=0
P0_FFMPEG_BIN=
# whisper engine: model size (medium|large-v3|small or a local dir), forced base language, and the
# bilingual initial prompt that locks Whisper into mixed zh+en. Model downloads from HF on first
# use — on blocked networks add: HF_ENDPOINT=https://hf-mirror.com
P0_WHOTALK_WHISPER_MODEL=medium
P0_WHOTALK_WHISPER_LANG=zh
P0_WHOTALK_WHISPER_PROMPT=以下是一段中英混合的工作会议对话，请按原话记录：中文写汉字，英文单词保留英文。例如：我们现在 check 一下这个 server 的 status，然后 update 给大家。

# ---- "p0" keyword detection: ask "is this a P0?" via a card, confirm by REPLYING ----
# Real Yes/Cancel BUTTONS need a callback round-trip to the bot: either the HTTP webhook (this
# bot runs ENABLE_HTTP=0, WS-only, no public port) or a CARD frame over the long connection —
# and the pinned lark-oapi client (v1.7.1, the newest release available on PyPI/GitHub) silently
# discards CARD frames in its WS loop before any handler ever sees them (verified in the SDK's own
# source: ws/client.py `elif message_type == MessageType.CARD: return`). So confirmation is a
# plain text reply over the same IM pipeline every other command already runs on.
# Whole-word "p0"/"P0" in a watched chat -> card asking to reply the confirm trigger within the
# window -> tags current on-duty (same roster /p0docs uses) + auto-runs /openmeeting.
P0_DETECT_ENABLE=1
# Comma/semicolon-separated chat_ids to watch; empty = P0_OPENMEETING_ANNOUNCE_CHAT_ID.
P0_DETECT_CHAT_IDS=
# Don't re-show the card in the same chat within this many seconds of the last one.
P0_DETECT_COOLDOWN_SECONDS=2700
# How long a shown card stays confirmable via P0_DETECT_CONFIRM_TRIGGER.
P0_DETECT_CONFIRM_WINDOW_SECONDS=900
P0_DETECT_CONFIRM_TRIGGER=/confirmp0
P0_DETECT_CARD_TEMPLATE=red
# Real 【Confirm】/【Cancel】 buttons on the P0 card. Card clicks arrive as WS "card" frames, which
# the pinned lark-oapi client discards; the bot re-types them to "event" so the SDK routes them to
# its card.action.trigger handler and replies over the WS. REQUIRES Developer Console
# 「事件与回调 → 回调配置 → 使用长连接接收事件」. 0 = buttons off (reply /confirmp0 only).
P0_CARD_BUTTONS_ENABLE=1

# ---- /p0docs: fill a P0 incident doc from a meeting transcript ----
# Usage: /p0docs <meeting link|9-digit no|minutes link> <doc link (/wiki/ or /docx/)>
# Qwen fills only the fields the transcript answers; unknown fields stay untouched. Tables are
# skipped. Needs scope docx:document (EDIT; add + PUBLISH) and the doc shared to the app as
# editable; if writing fails, the filled content is posted in chat for manual paste.
P0_P0DOCS_ENABLE=1
P0_P0DOCS_TRIGGER=/p0docs
P0_P0DOCS_PROMPT=
P0_P0DOCS_USE_LOCAL_ASR=0
P0_P0DOCS_TRANSCRIPT_CHARS=12000

# ---- /osemeeting: write the bilingual OSE / weekly meeting minutes from a recording ----
# Usage (the two links may be given in either order, one per line):
#   /osemeeting
#   <meeting link|9-digit no|minutes link>
#   <doc link (/wiki/ or /docx/)>
# Three models over ONE download of the recording:
#   audio  -> OpenAI ASR (whisper-1) hears it; speaker names come from the Minutes SRT and are
#             matched onto the ASR segments by time overlap
#   video  -> qwen2.5vl:3b looks at the sampled frames and keeps the ones that carry information
#             (shared screens, dashboards, errors, configs); near-duplicates never reach it
#   text   -> qwen3.6:35b-a3b writes the Overview values and the numbered discussion topics twice,
#             once under "English Version" and once under "中文版", placing the kept screenshots
#             under the topic they belong to
# Extra scopes beyond /p0docs: minutes:minutes.media:export (recording download) and drive:drive
# (image upload). The doc must be shared to the app as EDITABLE.
P0_OSEMEETING_ENABLE=1
P0_OSEMEETING_TRIGGER=/osemeeting
# -- audio: openai | local | lark. "openai" still falls back down that chain on any failure. --
P0_OSEMEETING_ASR_PROVIDER=openai
# Empty = read OPENAI_API_KEY from the environment instead.
P0_OSEMEETING_OPENAI_API_KEY=
P0_OSEMEETING_OPENAI_BASE_URL=https://api.openai.com/v1
# whisper-1 is the default because it is the only transcription model that still returns
# per-segment timestamps (verbose_json), and those timestamps are what let the bot line each
# sentence up with the right speaker. gpt-4o-transcribe returns text only, so with it a whole
# chunk gets attributed to whoever spoke most in it.
P0_OSEMEETING_OPENAI_ASR_MODEL=whisper-1
P0_OSEMEETING_ASR_LANG=
P0_OSEMEETING_ASR_PROMPT=Mixed Chinese/English OSE operations meeting. Keep English technical terms in English; write Chinese speech in 汉字.
# One OpenAI request is capped at 25 MB; 600 s of 32 kbps mono mp3 is ~2.4 MB, far under it.
P0_OSEMEETING_ASR_CHUNK_SECONDS=600
P0_OSEMEETING_ASR_BITRATE=32k
P0_OSEMEETING_ASR_TIMEOUT_SECONDS=300
# -- video --
P0_OSEMEETING_VISION_ENABLE=1
P0_OSEMEETING_VISION_MODEL=qwen2.5vl:3b
P0_OSEMEETING_FRAME_INTERVAL_SECONDS=20
P0_OSEMEETING_FRAME_WIDTH=1280
# Mean 0..255 pixel distance on a 16x16 grey thumbnail below which two samples are "the same
# screen". A screen share that sits still for five minutes then costs one look, not fifteen.
P0_OSEMEETING_FRAME_DEDUPE_THRESHOLD=3.0
P0_OSEMEETING_MAX_FRAMES=120
P0_OSEMEETING_MAX_IMAGES=8
P0_OSEMEETING_VISION_TIMEOUT_SECONDS=120
P0_OSEMEETING_VISION_PROMPT=
# -- text: empty writer model = P0_QA_MODEL / MONITORING_AI_MODEL --
P0_OSEMEETING_WRITER_MODEL=
P0_OSEMEETING_PROMPT=
P0_OSEMEETING_TRANSCRIPT_CHARS=24000
# The template ships with 4 topic slots; extra topics get new headings, unused slots stay as-is.
P0_OSEMEETING_MAX_TOPICS=10
# Overview values the meeting cannot supply. Empty "prepared by" leaves that cell untouched.
P0_OSEMEETING_PREPARED_BY=
P0_OSEMEETING_PARTICIPANTS_FALLBACK=MY OSE
P0_OSEMEETING_KEEP_MEDIA=0

# ---- /deploy (optional) ----
DEPLOY_ENABLE=0
# DEPLOY_SYSTEMD_SERVICE=p0bot
# DEPLOY_ALLOWED_USER_OPEN_ID=ou_your_open_id_here
